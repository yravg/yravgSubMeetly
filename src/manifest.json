{
  "manifest_version": 3,
  "name": "yravgSubMeetly",
  "version": "1.1.1",
  "description": "On-device realtime subtitles: local AI transcription + translation for any tab. Audio is not uploaded to our servers.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabCapture",
    "desktopCapture",
    "contextMenus",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "scripting",
    "sidePanel",
    "activeTab",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "yravgSubMeetly",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
