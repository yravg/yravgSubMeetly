{
  "name": "yraverage-submin",
  "version": "1.1.1",
  "private": true,
  "description": "yravgSubMeetly \u2014 on-device realtime subtitle & translation Chrome extension. Inference stays local after models download.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "dev:browser": "npm run build && node scripts/dev-browser.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:pipeline": "node scripts/smoke.mjs --pipeline",
    "smoke:crossos": "node scripts/smoke.mjs --crossos",
    "e2e": "node scripts/e2e.mjs",
    "e2e:pick": "node scripts/e2e.mjs --pick",
    "e2e:native": "node scripts/e2e.mjs --native",
    "e2e:harness": "node scripts/e2e.mjs --harness-only",
    "e2e:file": "node scripts/e2e-file.mjs",
    "e2e:crossos": "node scripts/e2e-crossos.mjs",
    "e2e:crossos:harness": "node scripts/e2e-crossos.mjs --harness-only",
    "bench:models": "node scripts/bench-models.mjs",
    "bench:models:catalog": "node scripts/bench-models.mjs --catalog-only",
    "bench:bigfile": "node scripts/bench-bigfile.mjs",
    "bench:bigfile:upload": "node scripts/bench-bigfile.mjs --upload",
    "bench:report": "node scripts/bench-report.mjs",
    "defects:gen": "node scripts/gen-defects.mjs",
    "release:gate": "node scripts/mark-release-priorities.mjs",
    "release:check": "node scripts/mark-release-priorities.mjs --check",
    "pack:store": "node scripts/pack-store.mjs",
    "pack:store:screens": "node scripts/capture-store-screens.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs test/*.test.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@ricky0123/vad-web": "^0.0.30"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "puppeteer": "^25.8.0"
  }
}
