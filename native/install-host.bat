@echo off
REM Install the Chrome/Edge Native Messaging host on Windows.
REM Usage: install-host.bat YOUR_EXTENSION_ID
REM
REM Two Windows-specific details this script exists for:
REM   1. Chrome cannot launch a .py file as a native messaging host. The
REM      manifest must point at an executable, so we generate a .bat wrapper
REM      that invokes Python with messaging_host.py.
REM   2. The manifest file alone is not enough on Windows: Chrome/Edge only
REM      discover the host through a registry key under HKCU.
setlocal EnableDelayedExpansion
cd /d "%~dp0"

if "%~1"=="" (
  echo Usage: install-host.bat ^<chrome-extension-id^>
  echo Find the ID on chrome://extensions ^(Developer mode^) or edge://extensions.
  exit /b 1
)

set "EXT_ID=%~1"
set "HOST_DIR=%~dp0"
set "HOST_PY=%HOST_DIR%messaging_host.py"

if not exist "%HOST_PY%" (
  echo ERROR: messaging_host.py not found next to this script.
  exit /b 1
)

REM --- locate Python -------------------------------------------------------
set "PY_CMD="
where py >nul 2>&1 && set "PY_CMD=py -3"
if not defined PY_CMD ( where python >nul 2>&1 && set "PY_CMD=python" )
if not defined PY_CMD (
  echo ERROR: Python 3 not found. Install it from python.org or the Microsoft Store,
  echo then re-run this script.
  exit /b 1
)

REM --- executable wrapper (Chrome cannot exec .py directly) ----------------
set "WRAPPER=%HOST_DIR%messaging_host.bat"
> "%WRAPPER%" (
  echo @echo off
  echo REM Generated by install-host.bat — launches the Python messaging host.
  echo %PY_CMD% "%HOST_PY%" %%*
)

REM --- manifest ------------------------------------------------------------
set "MANIFEST_DIR=%LOCALAPPDATA%\yraverageSubMin"
if not exist "%MANIFEST_DIR%" mkdir "%MANIFEST_DIR%"
set "MANIFEST=%MANIFEST_DIR%\com.localtranssub.helper.json"

REM JSON needs backslashes escaped.
set "WRAPPER_JSON=%WRAPPER:\=\\%"

> "%MANIFEST%" (
  echo {
  echo   "name": "com.localtranssub.helper",
  echo   "description": "yraverageSubMin native helper launcher",
  echo   "path": "%WRAPPER_JSON%",
  echo   "type": "stdio",
  echo   "allowed_origins": [
  echo     "chrome-extension://%EXT_ID%/"
  echo   ]
  echo }
)

REM --- registry: Chrome, Edge, Chromium ------------------------------------
call :register "HKCU\Software\Google\Chrome\NativeMessagingHosts" "Google Chrome"
call :register "HKCU\Software\Microsoft\Edge\NativeMessagingHosts" "Microsoft Edge"
call :register "HKCU\Software\Chromium\NativeMessagingHosts" "Chromium"

echo.
echo Manifest: %MANIFEST%
echo Wrapper : %WRAPPER%
echo Reload the extension, then Settings -^> Engine -^> Native helper -^> Start.
endlocal
exit /b 0

:register
reg add "%~1\com.localtranssub.helper" /ve /t REG_SZ /d "%MANIFEST%" /f >nul 2>&1
if errorlevel 1 (
  echo   - %~2: skipped
) else (
  echo   + %~2: registered
)
exit /b 0
