# Dependencies & virtualenvs
node_modules/
native/.venv/
.hf-cache/

# Build output
dist/
.build/
mac/.build/
mac/build/
*.icns

# Throwaway Chrome profiles created by the Puppeteer test scripts.
# These contain cookies and site data — never commit them.
.dev-profile/
.e2e-profile/

# Local cache, including exported YouTube cookies.
.lab-cache/

# Generated test audio (recreate with scripts/gen-samples.sh)
*.wav
*.aiff

# Transient sync metadata (config.json and summaries.json are kept)
.ngodingpakeai/pending.json

# Secrets — never commit
.env
.env.*
*.pem
*.p12
*-cookies.txt

# macOS / editor noise
.DS_Store
*.log
*.pid

# Python bytecode
__pycache__/
*.pyc
.e2e-file-profile/
.superpowers/

# Potongan ringkasan per-slice dari subagen (digabung ke summaries.json)
.ngodingpakeai/summaries.part-*.json

# Rust engine build output (Cargo target dir is usually external)
engine-rs/target/
qa/.pw-output/
qa/evidence/*
!qa/evidence/.gitkeep
